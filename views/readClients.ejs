<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Página do Cliente</title>
  </head>
  <body>
    <form action="" method="post" class="form">
      <label for="name">Nome:</label>
      <input type="text" value=" <%= client.name %>  " name="name" id="name" />

      <label for="email">Email: </label>
      <input
        type="email"
        value=" <%= client.email %> "
        name="email"
        id="email"
      />

      <label for="faq">Faq:</label>
      <input
        type="text"
        name="faq"
        id="faq"
        placeholder="Use para escrever as informações importantes"
      />

      <label for="prompt">Prompt:</label>
      <input
        type="text"
        name="prompt"
        id="prompt"
        placeholder="Use para escrever uma breve história da sua empresa e como ela funciona"
      />

      <input type="submit" value="Editar" />
    </form>
  </body>
</html>
