<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Planos | MercurioChat</title>
    <link rel="stylesheet" href="/stylesheets/app.css" />
    <link rel="stylesheet" href="/stylesheets/plans.css" /> 
    <link rel="shortcut icon" href="/assets/favicon.png" type="image/x-icon" />
</head>

<body>
    <div class="container">
        <div class="pricing-header">
            <h2>Planos e Preços</h2>
            <p>Escolha o plano ideal para o tamanho do seu negócio</p>
        </div>
        
        <div class="plans-container">
            <% plans.forEach((plan, index) => { %>
                <div class="plan-card <%= index === 1 ? 'featured-plan' : '' %>">
                    <% if (index === 1) { %>
                        <div class="featured-tag">Recomendado</div>
                    <% } %>
                    <h3 class="plan-name"><%= plan.name %></h3>
                    <div class="plan-price">
                        <div class="price-value"><%= plan.price %></div>
                        <div class="price-period">Duração: <%= plan.days %> dias</div>
                    </div>
                    <div id="<%= plan.name %>" data-plan="<%= plan.preferenceId %>" class="buyButton">
                  </div>
                </div>
            <% }) %>
        </div>
    </div>

    <script src="https://sdk.mercadopago.com/js/v2"></script>
    <script src="/scripts/purchaseLogic.js"></script>
    <script src="/scripts/checkoutMercadoPago.js"></script>
</body>
</html>
